  "query": "\n        UPDATE document SET\n            version = $2,\n            blob_id = NULL,\n            blob_size = 0,\n            deleted = true,\n            server_seq = nextval('document_change_seq'),\n            updated_at = $3\n        WHERE id = $1 AND version = $4\n        RETURNING id, version, blob_id, blob_size, enc_meta, deleted, server_seq, updated_at\n        ",
