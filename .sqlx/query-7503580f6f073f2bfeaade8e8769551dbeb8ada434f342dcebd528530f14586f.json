{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.id, b.vault_id\n        FROM blob b\n        WHERE NOT EXISTS (\n            SELECT 1 FROM document d WHERE d.blob_id = b.id AND d.deleted = false\n        )\n        AND b.created_at < now() - interval '24 hours'\n        FOR UPDATE SKIP LOCKED\n        ",
