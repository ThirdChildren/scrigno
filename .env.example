# Copy to .env and edit. .env is gitignored and must never be committed.

# --- Postgres (compose) ---------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# --- Server ---------------------------------------------------------------------------------
# Bearer token every client must present. Generate with:  openssl rand -hex 32
SCRIGNO_API_TOKEN=REPLACE_WITH_openssl_rand_hex_32
SCRIGNO_MAX_BLOB_BYTES=209715200
SCRIGNO_GC_INTERVAL_SECS=3600
SCRIGNO_PORT=8787
RUST_LOG=scrigno_server=info,tower_http=info

# Used when running the server natively with `just server` (cargo run) against compose Postgres.
SCRIGNO_DATABASE_URL=postgres://scrigno:change-me-dev-only@127.0.0.1:5432/scrigno
SCRIGNO_BLOB_DIR=./.data/blobs
SCRIGNO_BIND=127.0.0.1:8787   # use 0.0.0.0:8787 when a phone on the LAN must reach the native server

# sqlx-cli and #[sqlx::test] read this one (same value as SCRIGNO_DATABASE_URL).
DATABASE_URL=postgres://scrigno:change-me-dev-only@127.0.0.1:5432/scrigno

# --- Network exposure -----------------------------------------------------------------------
# 127.0.0.1 = only this machine (and the Android emulator via 10.0.2.2).
# 0.0.0.0   = also phones/tablets on the same LAN (dev only; on the homeserver nginx proxies to
#             127.0.0.1 so leave the default there).
SCRIGNO_PUBLISH_HOST=127.0.0.1

# --- CLI / e2e (optional) -------------------------------------------------------------------
# SCRIGNO_PASSPHRASE=only-for-scripts-never-for-real-vaults
